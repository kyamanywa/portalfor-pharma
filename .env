# Django Security Settings
SECRET_KEY=your-secret-key-here-change-this-to-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Settings
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (optional)
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@kpiops.com

# Two-Factor Authentication
USE_2FA=False

# Brute Force Protection (Django-Axes)
# Change these values to customize lockout behavior
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# Redis (optional, for production)
REDIS_URL=redis://localhost:6379

# Session Settings
SESSION_COOKIE_AGE=86400
